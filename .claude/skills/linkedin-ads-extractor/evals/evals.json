{
  "skill_name": "linkedin-ads-extractor",
  "evals": [
    {
      "id": 1,
      "name": "Extract Single Ad with Low Impressions",
      "description": "Test extraction of an ad with < 1k impressions (no country breakdown available)",
      "prompt": "Extract data from this single LinkedIn ad: https://www.linkedin.com/ad-library/detail/1365413366",
      "expected_output": {
        "file": "linkedin_ad_1365413366.json",
        "assertions": [
          {
            "type": "json_valid",
            "description": "Output must be valid JSON"
          },
          {
            "type": "field_exists",
            "path": "ads[0].ad_id",
            "description": "Ad ID must be extracted"
          },
          {
            "type": "field_value",
            "path": "ads[0].ad_id",
            "expected_value": "1365413366",
            "description": "Ad ID should be 1365413366"
          },
          {
            "type": "field_exists",
            "path": "ads[0].url",
            "description": "Ad URL must be included"
          },
          {
            "type": "field_exists",
            "path": "ads[0].about.advertiser",
            "description": "Advertiser must be extracted"
          },
          {
            "type": "field_exists",
            "path": "ads[0].about.format",
            "description": "Ad format must be extracted"
          },
          {
            "type": "field_exists",
            "path": "ads[0].about.ad_text",
            "description": "Ad text must be extracted"
          },
          {
            "type": "field_not_contains",
            "path": "ads[0].about.ad_text",
            "not_expected": "…",
            "description": "Ad text should NOT end with ellipsis (must be expanded)"
          },
          {
            "type": "field_exists",
            "path": "ads[0].impressions.total_range",
            "description": "Total impressions range must be extracted"
          },
          {
            "type": "field_exists",
            "path": "ads[0].impressions.by_country",
            "description": "by_country array must exist"
          },
          {
            "type": "field_type",
            "path": "ads[0].impressions.by_country",
            "expected_type": "array",
            "description": "by_country must be an array"
          },
          {
            "type": "field_not_exists",
            "path": "ads[0].impressions.by_date",
            "description": "by_date should NOT exist"
          },
          {
            "type": "field_exists",
            "path": "ads[0].targeting",
            "description": "Targeting section must exist"
          },
          {
            "type": "field_type",
            "path": "ads[0].targeting.languages",
            "expected_type": "array",
            "description": "Languages must be an array"
          },
          {
            "type": "field_type",
            "path": "ads[0].targeting.locations",
            "expected_type": "array",
            "description": "Locations must be an array"
          },
          {
            "type": "array_min_length",
            "path": "ads[0].targeting.locations",
            "min_length": 3,
            "description": "Locations should have at least 3 items (proves 'x others' button was clicked)"
          }
        ]
      },
      "success_criteria": {
        "ad_text_complete": true,
        "locations_expanded": true,
        "country_data_handled": true
      }
    },
    {
      "id": 2,
      "name": "Extract Single Ad with High Impressions",
      "description": "Test extraction of an ad with 30k-50k impressions (with country breakdown)",
      "prompt": "Extract data from this LinkedIn ad: https://www.linkedin.com/ad-library/detail/1180600313",
      "expected_output": {
        "file": "linkedin_ad_1180600313.json",
        "assertions": [
          {
            "type": "json_valid",
            "description": "Output must be valid JSON"
          },
          {
            "type": "field_value",
            "path": "ads[0].ad_id",
            "expected_value": "1180600313",
            "description": "Ad ID should be 1180600313"
          },
          {
            "type": "field_exists",
            "path": "ads[0].about.advertiser",
            "description": "Advertiser must be extracted"
          },
          {
            "type": "field_exists",
            "path": "ads[0].impressions.total_range",
            "description": "Total impressions must be extracted"
          },
          {
            "type": "field_exists",
            "path": "ads[0].impressions.by_country",
            "description": "Country breakdown must exist"
          },
          {
            "type": "array_min_length",
            "path": "ads[0].impressions.by_country",
            "min_length": 10,
            "description": "Must have at least 10 countries (proves 'Show more' was clicked)"
          },
          {
            "type": "field_exists",
            "path": "ads[0].impressions.by_country[0].country",
            "description": "Each country entry must have country name"
          },
          {
            "type": "field_exists",
            "path": "ads[0].impressions.by_country[0].percentage",
            "description": "Each country entry must have percentage"
          },
          {
            "type": "field_not_exists",
            "path": "ads[0].impressions.by_date",
            "description": "by_date should NOT exist"
          }
        ]
      },
      "success_criteria": {
        "show_more_clicked": true,
        "country_data_complete": true
      }
    },
    {
      "id": 3,
      "name": "Targeting Details Boolean Detection",
      "description": "Test correct detection of li-icon type='check' (true) vs type='minus' (false) in targeting details table",
      "prompt": "Extract data from this LinkedIn ad: https://www.linkedin.com/ad-library/detail/1147098174",
      "expected_output": {
        "file": "linkedin_ad_1147098174.json",
        "assertions": [
          {
            "type": "json_valid",
            "description": "Output must be valid JSON"
          },
          {
            "type": "field_value",
            "path": "ads[0].ad_id",
            "expected_value": "1147098174",
            "description": "Ad ID should be 1147098174"
          },
          {
            "type": "field_exists",
            "path": "ads[0].targeting",
            "description": "Targeting section must exist"
          },
          {
            "type": "field_exists",
            "path": "ads[0].targeting.details",
            "description": "Targeting details array must exist"
          },
          {
            "type": "field_type",
            "path": "ads[0].targeting.details",
            "expected_type": "array",
            "description": "Targeting details must be an array"
          },
          {
            "type": "array_min_length",
            "path": "ads[0].targeting.details",
            "min_length": 1,
            "description": "At least one targeting parameter must be extracted"
          },
          {
            "type": "field_exists",
            "path": "ads[0].targeting.details[0].parameter",
            "description": "Each targeting detail must have a parameter name"
          },
          {
            "type": "field_type",
            "path": "ads[0].targeting.details[0].targeted",
            "expected_type": "boolean",
            "description": "Targeted field must be a boolean"
          },
          {
            "type": "field_type",
            "path": "ads[0].targeting.details[0].excluded",
            "expected_type": "boolean",
            "description": "Excluded field must be a boolean"
          },
          {
            "type": "script_check",
            "script": "data.ads[0].targeting.details.some(d => d.targeted === true)",
            "description": "At least one parameter should have targeted=true (check icon detected)"
          },
          {
            "type": "script_check",
            "script": "data.ads[0].targeting.details.some(d => d.targeted === false || d.excluded === true)",
            "description": "At least one parameter should have targeted=false or excluded=true (minus icon detected)"
          },
          {
            "type": "field_not_contains",
            "path": "ads[0].targeting.details",
            "not_expected": "img",
            "description": "Targeting details should NOT contain img references (must use li-icon detection)"
          }
        ]
      },
      "success_criteria": {
        "icon_type_detection": true,
        "check_icon_true": true,
        "minus_icon_false": true
      }
    },
    {
      "id": 4,
      "name": "Extract Multiple Ads from Search",
      "description": "Test extraction of multiple ads from a search results page",
      "prompt": "Extract the first 3 ads from this LinkedIn Ad Library search: https://www.linkedin.com/ad-library/search?accountOwner=payoneer&payer=Payoneer",
      "expected_output": {
        "file": "linkedin_ads_payoneer.json",
        "assertions": [
          {
            "type": "json_valid",
            "description": "Output must be valid JSON"
          },
          {
            "type": "field_exists",
            "path": "search_metadata",
            "description": "Search metadata must exist"
          },
          {
            "type": "field_exists",
            "path": "search_metadata.search_url",
            "description": "Search URL must be recorded"
          },
          {
            "type": "field_exists",
            "path": "search_metadata.total_ads_found",
            "description": "Total ads count must be recorded"
          },
          {
            "type": "field_exists",
            "path": "ads",
            "description": "Ads array must exist"
          },
          {
            "type": "array_min_length",
            "path": "ads",
            "min_length": 3,
            "description": "At least 3 ads must be extracted"
          },
          {
            "type": "field_exists",
            "path": "ads[0].url",
            "description": "Each ad must have URL"
          },
          {
            "type": "field_exists",
            "path": "ads[0].about",
            "description": "Each ad must have about section"
          },
          {
            "type": "field_exists",
            "path": "ads[0].impressions",
            "description": "Each ad must have impressions section"
          },
          {
            "type": "field_exists",
            "path": "ads[0].targeting",
            "description": "Each ad must have targeting section"
          }
        ]
      },
      "success_criteria": {
        "multiple_ads_extracted": true,
        "all_ads_complete": true
      }
    }
  ],
  "validation_rules": {
    "snapshot_parsing": {
      "description": "All data must be extracted from the Playwright snapshot YAML structure"
    },
    "expansion_buttons": {
      "see_more_text": "Click '…see more' button if present in ad preview",
      "show_more_countries": "Click 'Show more' button if present in Impressions section",
      "x_others_targeting": "Click 'x others' buttons if present in Language/Location fields"
    },
    "impressions": {
      "low_impressions": "Ads with < 1k impressions have NO country breakdown - use empty array",
      "high_impressions": "Ads with higher impressions have country breakdown - extract ALL countries after clicking 'Show more'",
      "no_by_date": "NEVER create by_date field - LinkedIn only provides country-based data"
    },
    "output_structure": {
      "include_url": "Always include the ad detail URL in output",
      "arrays_required": "Languages and locations must always be arrays",
      "complete_text": "Ad text must be complete (not truncated)"
    }
  },
  "test_scenarios": [
    {
      "scenario": "Ad with < 1k impressions",
      "description": "Low impression ads show message about data not being available yet",
      "expected_behavior": "Extract total_range as '< 1k' and by_country as empty array []"
    },
    {
      "scenario": "Ad with high impressions",
      "description": "High impression ads show country breakdown with 'Show more' button",
      "expected_behavior": "Click 'Show more' to reveal 60+ countries, extract all of them"
    },
    {
      "scenario": "Truncated ad text",
      "description": "Ad text shows '…see more' button",
      "expected_behavior": "Click button to expand, extract full text from new snapshot"
    },
    {
      "scenario": "Hidden targeting locations",
      "description": "Location field shows 'x others' button",
      "expected_behavior": "Click button to expand, extract all locations from new snapshot"
    }
  ],
  "common_mistakes": [
    {
      "mistake": "Not parsing snapshot YAML",
      "impact": "All data is in the snapshot - if not parsing carefully, data will be missed",
      "detection": "Output has null/missing values when snapshot clearly contains the data"
    },
    {
      "mistake": "Not clicking 'Show more' for countries",
      "impact": "Only 4 countries extracted instead of 60+",
      "detection": "by_country array has 4 or fewer entries for high-impression ads"
    },
    {
      "mistake": "Not clicking '…see more' for text",
      "impact": "Truncated ad text with ellipsis",
      "detection": "ad_text ends with '…' or is very short"
    },
    {
      "mistake": "Not handling low-impression ads",
      "impact": "Error or missing data for ads with < 1k impressions",
      "detection": "Extraction fails or by_country is missing for ads with '< 1k' total"
    },
    {
      "mistake": "Creating by_date field",
      "impact": "Incorrect schema - LinkedIn doesn't provide date-based impressions",
      "detection": "impressions.by_date field exists in output"
    }
  ]
}
